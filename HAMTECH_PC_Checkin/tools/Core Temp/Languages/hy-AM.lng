      <Value> RC5</Value>
    </String>
    <String>
      <Id>104</Id>
      <IdName>IDS_APP_TITLE_VER</IdName>
      <Value>Core Temp-ի տարբերակ</Value>
    </String>
    <String>
      <Id>235</Id>
      <IdName>IDS_CheckAmdDriverUpdate</IdName>
      <Value>Ստուգել AMD սարքավարների թարմացումները</Value>
    </String>
    <String>
      <Id>247</Id>
      <IdName>IDS_CheckBiosUpdate</IdName>
      <Value>Ստուգել BIOS-ի թարմացումները</Value>
    </String>
    <String>
      <Id>233</Id>
      <IdName>IDS_CheckDriverUpdate</IdName>
      <Value>Ստուգել սարքավարների թարմացումները</Value>
    </String>
    <String>
      <Id>234</Id>
      <IdName>IDS_CheckIntelDriverUpdate</IdName>
      <Value>Ստուգել Intel սարքավարների թարմացումները</Value>
    </String>
    <String>
      <Id>168</Id>
      <IdName>IDS_CoreTempMiscRegistryEntryNotFound</IdName>
      <Value>Գրանցման գրառումը չի գտնվել:&#10;&#13;'Մեկնարկել Core Temp-ը Windows-ի հետ' կարգավորումը չի պահպանվի:</Value>
    </String>
    <String>
      <Id>167</Id>
      <IdName>IDS_CoreTempMiscScheduledTask</IdName>
      <Value>Հերթագրված խնդիրը՝ Core Temp-ը Windows-ի հետ ինքնաբար բացելու համար չի կարող ստեղծվել/մատչված կարգավորումը չի պահպանվել:</Value>
    </String>
    <String>
      <Id>244</Id>
      <IdName>IDS_FrequencySelectorHighest</IdName>
      <Value>Ամենաբարձր</Value>
    </String>
    <String>
      <Id>245</Id>
      <IdName>IDS_FrequencySelectorTooltip</IdName>
      <Value>Սեղմեք մկնիկի աջ կոճակը՝ միջուկի հաճախականությունը ընտրելու համար</Value>
    </String>
    <String>
      <Id>162</Id>
      <IdName>IDS_InitializeMessageDataInitFailed</IdName>
      <Value>Core Temp-ը չկարողացավ սկզբնավորել ներքին տվյալը:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>161</Id>
      <IdName>IDS_InitializeMessageDriverFailed</IdName>
      <Value>Սարքավարը չկարողացավ բեռնվել:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>164</Id>
      <IdName>IDS_InitializeMessageDriverOutdated</IdName>
      <Value>Ընթացիկ բեռնված սարքավարը հին է:&#10;&#13;Համոզվեք, որ չունեք որևէ այլ աշխատեցված ծրագիր ALCPU-ից և փորձեք վերագործարկել Core Temp-ը:&#10;&#13;Core Temp-ը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>157</Id>
      <IdName>IDS_InitializeMessageDuplicateInstance</IdName>
      <Value>Աշխատեցված է Core Temp-ի մեկ այլ օրինակ:</Value>
    </String>
    <String>
      <Id>165</Id>
      <IdName>IDS_InitializeMessageInternalError</IdName>
      <Value>Core Temp-ի ներքին սխալ:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>166</Id>
      <IdName>IDS_InitializeMessageOsNotSupported</IdName>
      <Value>Այս ծրագիրը պահանջում է Windows 2000/XP/2003/Vista/7:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>163</Id>
      <IdName>IDS_InitializeMessageProcessorNotFound</IdName>
      <Value>Core Temp-ը չի գտել աջակցվող որևէ մշակիչ:&#10;&#13;Ծրագիրը չի շարունակվի:&#10;&#13;&#10;&#13;Եթե համոզված եք, որ ձեր CPU-ն աջակցվողների ցանկից է, ապա ստեղծեք գրանցարանի պարպելու ֆայլ, որ մենք կարողանանք ուղղել խնդիրը:</Value>
    </String>
    <String>
      <Id>159</Id>
      <IdName>IDS_InitializeMessageUnsupportedCpuAmd</IdName>
      <Value>Այս AMD մշակիչը չի աջակցվում:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>160</Id>
      <IdName>IDS_InitializeMessageUnsupportedCpuIntel</IdName>
      <Value>Այս Intel մշակիչը չի աջակցվում:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
    <String>
      <Id>158</Id>
      <IdName>IDS_InitializeMessageUnsupportedVendor</IdName>
      <Value>Մշակիչի այս արտադրողը չի աջակցվում:&#10;&#13;Ծրագիրը չի շարունակվի:</Value>
    </String>
