          <Text>Հաճախ տրվող հարցեր</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_GADGET</IdName>
          <Text>Ստուգել միջուկի ջերմաստիճանը Windows 7 և Vista-ի համար</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
