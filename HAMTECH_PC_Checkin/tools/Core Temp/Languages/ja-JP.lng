        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1061</Id>
          <IdName>IDC_W7TBLoad</IdName>
          <Text>CPU負荷</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1063</Id>
          <IdName>IDC_W7TBMinimize</IdName>
