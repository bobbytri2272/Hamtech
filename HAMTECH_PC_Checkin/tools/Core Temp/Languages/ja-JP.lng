        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>2</Id>
          <IdName>IDCANCEL</IdName>
          <Text>キャンセル</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>3</Id>
          <IdName>IDDEFAULTS</IdName>
          <Text>既定値</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1058</Id>
          <IdName>IDC_W7TBEnable</IdName>
