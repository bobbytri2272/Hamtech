  <Dialogs>
    <Dialog>
      <Id>103</Id>
      <IdName>IDD_ABOUTBOX</IdName>
      <Caption>このソフトについて</Caption>
      <Controls>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1002</Id>
          <IdName>IDC_APP_TITLE</IdName>
          <Text></Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1120</Id>
          <IdName>IDC_ACopyright</IdName>
          <Text>著作権 (C) 2006 - 2026 Alcpu</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1</Id>
          <IdName>IDOK</IdName>
          <Text>OK</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1121</Id>
          <IdName>IDC_AAuthor</IdName>
          <Text>開発者: Arthur Liberman</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1000</Id>
          <IdName>IDC_EMAIL</IdName>
          <Text>連絡する!</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1001</Id>
          <IdName>IDC_DONATE</IdName>
          <Text>寄付を受け付けています</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1003</Id>
          <IdName>IDC_HOMEPAGE</IdName>
          <Text>ホームページを訪問</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1122</Id>
          <IdName>IDC_AThanksRay</IdName>
          <Text>Ray Adams に多大な感謝。システムトレイに温度取得機能をつけることを大きく手助けしてくれました。</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1123</Id>
          <IdName>IDC_AThanksMichael</IdName>
          <Text>Michael Charness に多大な感謝。Core Temp アイコンの作成者です。</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1124</Id>
          <IdName>IDC_IDC_AThanksCoolIT</IdName>
          <Text>CPUIDに多大な感謝。Windows 7とVistaで要求されるデジタル署名のあるドライバーに貢献しました。</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1004</Id>
          <IdName>IDC_FORUM</IdName>
          <Text>サポートフォーラム</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1005</Id>
          <IdName>IDC_SCYTHE</IdName>
          <Text>Scythe は公式に推奨してくださいました。</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>IDC_FORUM2</IdName>
          <Text>よくある質問</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_GADGET</IdName>
          <Text>Windows 7 &amp;&amp; Vista 用の Core Temp ガジェットを見てみる</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_TranslationCredits</IdName>
          <Text>翻訳: wwwcfe (most), maboroshin (update in 2020)</Text>
        </Control>
      </Controls>
    </Dialog>
    <Dialog>
      <Id>158</Id>
      <IdName>IDD_OVERHEAT</IdName>
      <Caption>過熱保護の設定</Caption>
      <Controls>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1</Id>
          <IdName>IDOK</IdName>
          <Text>OK</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>2</Id>
          <IdName>IDCANCEL</IdName>
          <Text>キャンセル</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_ENABLE</IdName>
          <Text>過熱保護を有効化</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>GRP_SETTINGS</IdName>
          <Text>設定</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1022</Id>
          <IdName>IDC_ACTAT3</IdName>
          <Text>自動</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1020</Id>
          <IdName>IDC_NOTIFYHOT</IdName>
          <Text>限界温度に達した場合のみ通知</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1023</Id>
          <IdName>IDC_ACTAT1</IdName>
          <Text>指定した温度に達した場合実行</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1025</Id>
          <IdName>IDC_Celcius</IdName>
          <Text>°</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1024</Id>
          <IdName>IDC_ACTAT2</IdName>
          <Text>TjMax に達した場合に実行 (5°C 以下)</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_BALLOON</IdName>
          <Text>バルーン通知</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1009</Id>
          <IdName>IDC_TBFLASH</IdName>
          <Text>Core Temp タスクバーを点滅させる</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1126</Id>
          <IdName>IDC_OPExecute</IdName>
          <Text>プログラム実行:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1012</Id>
          <IdName>IDC_BROWSE</IdName>
          <Text>参照</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1068</Id>
          <IdName>IDC_OHPExecOnce</IdName>
          <Text>一度のみ実行</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1127</Id>
          <IdName>IDC_OPShutdownOptions</IdName>
          <Text>シャットダウンのオプション:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1010</Id>
          <IdName>IDC_ENABLESHUTDOWN</IdName>
          <Text>有効</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1015</Id>
          <IdName>IDC_RADIO_SD3</IdName>
          <Text>システムをスリープ状態にする</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1016</Id>
          <IdName>IDC_RADIO_SD4</IdName>
          <Text>休止状態</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1017</Id>
          <IdName>IDC_RADIO_SD5</IdName>
          <Text>電源を切る</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1027</Id>
          <IdName>IDC_LBLSHUTDOWN</IdName>
          <Text>シャットダウンまで</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1026</Id>
          <IdName>IDC_LBLSECS</IdName>
          <Text>秒</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>3</Id>
          <IdName>IDDEFAULTS</IdName>
          <Text>既定</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1125</Id>
          <IdName>IDC_OPNotification</IdName>
          <Text>通知:</Text>
        </Control>
      </Controls>
    </Dialog>
