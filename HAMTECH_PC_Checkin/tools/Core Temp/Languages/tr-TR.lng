          <IdName>IDC_FORUM</IdName>
          <Text>Destek forumu</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1005</Id>
          <IdName>IDC_SCYTHE</IdName>
          <Text>Scythe tarafından resmi olarak önerilmiştir.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>IDC_FORUM2</IdName>
          <Text>Sık sorulan sorular</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_GADGET</IdName>
