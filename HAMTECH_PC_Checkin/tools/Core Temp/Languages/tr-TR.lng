        <Control RightAlignText="false" RightToLeft="false">
          <Id>1122</Id>
          <IdName>IDC_AThanksRay</IdName>
          <Text>Sistem çubuğuna sıcaklıkları yerleştirmemi sağlayan Ray Adams'a teşekkür ederim.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1123</Id>
          <IdName>IDC_AThanksMichael</IdName>
          <Text>Çekirdek sıcaklığı ikonu için Michael Charness'e teşekkür ederim.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1124</Id>
          <IdName>IDC_IDC_AThanksCoolIT</IdName>
          <Text>Windows 7 ve Vista için gerekli olan dijital imzalı sürücü katkıları için CPUID'e teşekkür ederim.</Text>
        </Control>
