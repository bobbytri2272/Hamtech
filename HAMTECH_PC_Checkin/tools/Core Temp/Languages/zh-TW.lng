  <Dialogs>
    <Dialog>
      <Id>103</Id>
      <IdName>IDD_ABOUTBOX</IdName>
      <Caption>關於</Caption>
      <Controls>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1002</Id>
          <IdName>IDC_APP_TITLE</IdName>
          <Text></Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1120</Id>
          <IdName>IDC_ACopyright</IdName>
          <Text>版權所有 (C) 2006 - 2026 Alcpu</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1</Id>
          <IdName>IDOK</IdName>
          <Text>確定</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1121</Id>
          <IdName>IDC_AAuthor</IdName>
          <Text>作者: Arthur Liberman</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1000</Id>
          <IdName>IDC_EMAIL</IdName>
          <Text>聯絡作者!</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1001</Id>
          <IdName>IDC_DONATE</IdName>
          <Text>贊助!</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1003</Id>
          <IdName>IDC_HOMEPAGE</IdName>
          <Text>訪問首頁</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1122</Id>
          <IdName>IDC_AThanksRay</IdName>
          <Text>特別感謝 Ray Adams 對將溫度讀數放入工作列上提供了很大的幫助。</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1123</Id>
          <IdName>IDC_AThanksMichael</IdName>
          <Text>特別感謝 Michael Charness 的 Core Temp 圖示。</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1004</Id>
          <IdName>IDC_FORUM</IdName>
          <Text>論壇支援</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1005</Id>
          <IdName>IDC_SCYTHE</IdName>
          <Text>Scythe 正式推薦</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>IDC_FORUM2</IdName>
          <Text>常見問題 (FAQ)</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_GADGET</IdName>
          <Text>使用 Windows 7 和 Vista 系統的使用者建議察看使否要使用的小工具</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_TranslationCredits</IdName>
          <Text>翻譯：leojts at hotmail 修正與補充自簡體中文版&#10;&#13;更新：2017-06-02</Text>
        </Control>
      </Controls>
    </Dialog>
    <Dialog>
      <Id>158</Id>
      <IdName>IDD_OVERHEAT</IdName>
      <Caption>過熱保護設定</Caption>
      <Controls>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1</Id>
          <IdName>IDOK</IdName>
          <Text>確定</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>2</Id>
          <IdName>IDCANCEL</IdName>
          <Text>取消</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_ENABLE</IdName>
          <Text>啟用過熱保護</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>GRP_SETTINGS</IdName>
          <Text>設定</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1022</Id>
          <IdName>IDC_ACTAT3</IdName>
          <Text>自動</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1020</Id>
          <IdName>IDC_NOTIFYHOT</IdName>
          <Text>當達到臨界溫度時僅通知</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1023</Id>
          <IdName>IDC_ACTAT1</IdName>
          <Text>在指定的溫度下啟動</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1025</Id>
          <IdName>IDC_Celcius</IdName>
          <Text>°</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1024</Id>
          <IdName>IDC_ACTAT2</IdName>
          <Text>達到最高臨界溫度 -5℃ 時啟動</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_BALLOON</IdName>
          <Text>彈出氣泡框</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1009</Id>
          <IdName>IDC_TBFLASH</IdName>
          <Text>在工作列上閃爍 Core Temp</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1126</Id>
          <IdName>IDC_OPExecute</IdName>
          <Text>執行程式:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1012</Id>
          <IdName>IDC_BROWSE</IdName>
          <Text>瀏覽</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1068</Id>
          <IdName>IDC_OHPExecOnce</IdName>
          <Text>運行一次</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1127</Id>
          <IdName>IDC_OPShutdownOptions</IdName>
          <Text>關閉選項:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1010</Id>
          <IdName>IDC_ENABLESHUTDOWN</IdName>
          <Text>啟用</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1015</Id>
          <IdName>IDC_RADIO_SD3</IdName>
          <Text>將系統待機 (睡眠)</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1016</Id>
          <IdName>IDC_RADIO_SD4</IdName>
          <Text>休眠</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1017</Id>
          <IdName>IDC_RADIO_SD5</IdName>
          <Text>關機</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1027</Id>
          <IdName>IDC_LBLSHUTDOWN</IdName>
          <Text>倒計時</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1026</Id>
          <IdName>IDC_LBLSECS</IdName>
          <Text>秒後關機</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>3</Id>
          <IdName>IDDEFAULTS</IdName>
          <Text>還原預設設定</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1125</Id>
          <IdName>IDC_OPNotification</IdName>
          <Text>注意:</Text>
        </Control>
      </Controls>
    </Dialog>
