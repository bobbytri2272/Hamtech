    <Dialog>
      <Id>158</Id>
      <IdName>IDD_OVERHEAT</IdName>
      <Caption>Réglages de la protection anti-surchauffe</Caption>
      <Controls>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1</Id>
          <IdName>IDOK</IdName>
          <Text>OK</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>2</Id>
          <IdName>IDCANCEL</IdName>
          <Text>Annuler</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_ENABLE</IdName>
          <Text>Activer la protection anti-surchauffe</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>GRP_SETTINGS</IdName>
          <Text>Réglages</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1022</Id>
          <IdName>IDC_ACTAT3</IdName>
          <Text>Automatiques</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1020</Id>
          <IdName>IDC_NOTIFYHOT</IdName>
          <Text>Avertir seulement lorsque la température critique est atteinte</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1023</Id>
          <IdName>IDC_ACTAT1</IdName>
          <Text>Activer à la température spécifiée</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1025</Id>
          <IdName>IDC_Celcius</IdName>
          <Text>°</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1024</Id>
          <IdName>IDC_ACTAT2</IdName>
          <Text>Activer si TjMax est atteinte (5 °C en dessous)</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_BALLOON</IdName>
          <Text>Notifier par info-bulle</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1009</Id>
          <IdName>IDC_TBFLASH</IdName>
          <Text>Faire clignoter Core Temp dans la barre des tâches</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1126</Id>
          <IdName>IDC_OPExecute</IdName>
          <Text>Exécuter:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1012</Id>
          <IdName>IDC_BROWSE</IdName>
          <Text>Parcourir</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1068</Id>
          <IdName>IDC_OHPExecOnce</IdName>
          <Text>Une seule fois</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1127</Id>
          <IdName>IDC_OPShutdownOptions</IdName>
          <Text>Options d'arrêt:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1010</Id>
          <IdName>IDC_ENABLESHUTDOWN</IdName>
          <Text>Activer</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1015</Id>
          <IdName>IDC_RADIO_SD3</IdName>
          <Text>Mettre en veille</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1016</Id>
          <IdName>IDC_RADIO_SD4</IdName>
          <Text>Mettre en veille prolongée</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1017</Id>
          <IdName>IDC_RADIO_SD5</IdName>
          <Text>Arrêter</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1027</Id>
          <IdName>IDC_LBLSHUTDOWN</IdName>
          <Text>Arrêter après:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1026</Id>
          <IdName>IDC_LBLSECS</IdName>
          <Text>secondes</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>3</Id>
          <IdName>IDDEFAULTS</IdName>
          <Text>Par défaut</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1125</Id>
          <IdName>IDC_OPNotification</IdName>
          <Text>Notification:</Text>
        </Control>
      </Controls>
