        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1020</Id>
          <IdName>IDC_NOTIFYHOT</IdName>
          <Text>한계 온도에 도달 한 경우에만 알림</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1023</Id>
          <IdName>IDC_ACTAT1</IdName>
          <Text>지정한 온도에 도달하면 실행</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1025</Id>
          <IdName>IDC_Celcius</IdName>
          <Text>°</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1024</Id>
          <IdName>IDC_ACTAT2</IdName>
          <Text>TjMax에 도달하면 실행 (5°C 이하)</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_BALLOON</IdName>
          <Text>풍선 도움말</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1009</Id>
          <IdName>IDC_TBFLASH</IdName>
