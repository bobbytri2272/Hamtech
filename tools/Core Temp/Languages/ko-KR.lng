        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1122</Id>
          <IdName>IDC_AThanksRay</IdName>
          <Text>Special thanks to Ray Adams for the great help in adding temperature readings to system tray.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1123</Id>
          <IdName>IDC_AThanksMichael</IdName>
          <Text>Special thanks to Michael Charness for the Core Temp icon.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1124</Id>
          <IdName>IDC_IDC_AThanksCoolIT</IdName>
          <Text>Special thanks to CPUID for their contribution of digitally signed drivers, which are required by Windows 7 and Vista.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1004</Id>
          <IdName>IDC_FORUM</IdName>
