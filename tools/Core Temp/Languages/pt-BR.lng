          <Id>1008</Id>
          <IdName>IDC_BALLOON</IdName>
          <Text>Pop-up balão</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1009</Id>
          <IdName>IDC_TBFLASH</IdName>
          <Text>Flash Core Temp na barra de tarefas</Text>
        </Control>
