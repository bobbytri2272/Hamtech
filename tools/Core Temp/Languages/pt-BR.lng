          <Id>1010</Id>
          <IdName>IDC_ENABLESHUTDOWN</IdName>
          <Text>Ativar</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1015</Id>
          <IdName>IDC_RADIO_SD3</IdName>
