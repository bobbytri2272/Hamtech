        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1006</Id>
          <IdName>IDC_ENABLE</IdName>
          <Text>Включить защиту</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1007</Id>
          <IdName>GRP_SETTINGS</IdName>
          <Text>Настройки</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1022</Id>
          <IdName>IDC_ACTAT3</IdName>
          <Text>Автоматически</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1020</Id>
          <IdName>IDC_NOTIFYHOT</IdName>
          <Text>Оповещать только при достижении критической температуры</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1023</Id>
          <IdName>IDC_ACTAT1</IdName>
          <Text>Включить при достижении заданной температуры</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1025</Id>
          <IdName>IDC_Celcius</IdName>
          <Text>°</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1024</Id>
          <IdName>IDC_ACTAT2</IdName>
          <Text>Включить при достижении Tj Max (на 5° ниже)</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1008</Id>
          <IdName>IDC_BALLOON</IdName>
          <Text>Всплывающие подсказки</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1009</Id>
          <IdName>IDC_TBFLASH</IdName>
          <Text>Мигание иконки Core Temp на панели задач</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1126</Id>
          <IdName>IDC_OPExecute</IdName>
          <Text>Запустить программу:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1012</Id>
          <IdName>IDC_BROWSE</IdName>
          <Text>Обзор</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1068</Id>
          <IdName>IDC_OHPExecOnce</IdName>
          <Text>Один раз</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1127</Id>
          <IdName>IDC_OPShutdownOptions</IdName>
          <Text>Завершение работы:</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1010</Id>
          <IdName>IDC_ENABLESHUTDOWN</IdName>
          <Text>Включить</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1015</Id>
          <IdName>IDC_RADIO_SD3</IdName>
          <Text>Спящий режим</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1016</Id>
          <IdName>IDC_RADIO_SD4</IdName>
          <Text>Гибернация</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1017</Id>
          <IdName>IDC_RADIO_SD5</IdName>
          <Text>Выключение</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1027</Id>
          <IdName>IDC_LBLSHUTDOWN</IdName>
          <Text>Выключить после</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1026</Id>
          <IdName>IDC_LBLSECS</IdName>
