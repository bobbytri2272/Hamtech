        <Control RightAlignText="false" RightToLeft="false">
          <Id>1122</Id>
          <IdName>IDC_AThanksRay</IdName>
          <Text>Особая благодарность Рэю Адамсу за помощь с показанием температуры в области уведомлений.</Text>
        </Control>
        <Control RightAlignText="false" RightToLeft="false">
          <Id>1123</Id>
