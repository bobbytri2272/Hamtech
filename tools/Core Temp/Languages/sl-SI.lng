    </String>
    <String>
      <Id>167</Id>
      <IdName>IDS_CoreTempMiscScheduledTask</IdName>
      <Value>Načrtovane naloge za samodejni zagon programa Core Temp z operacijskim sistemom Windows ni bilo mogoče ustvariti/dostopati do nastavitve, ki ne bo shranjena.</Value>
    </String>
